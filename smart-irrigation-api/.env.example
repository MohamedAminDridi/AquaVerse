# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB (only database needed) ───────────────
# Local:
MONGO_URI=mongodb://localhost:27017/smart_irrigation
# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/smart_irrigation?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── MQTT (LOCAL broker — always on) ──────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=irrigation-backend

# ── MQTT (CLOUD broker — optional, toggled from AquaVerse → Settings) ──
# Add your HiveMQ Cloud (or other) broker here. The backend connects to it only
# when the "Cloud broker" switch is ON in the UI (or MQTT_CLOUD_DEFAULT=true).
# HiveMQ Cloud requires TLS → use the mqtts:// scheme on port 8883.
MQTT_CLOUD_URL=mqtts://xxxxx.s1.eu.hivemq.cloud:8883
MQTT_CLOUD_USERNAME=
MQTT_CLOUD_PASSWORD=
# Start with the cloud broker already ON when the server boots (optional):
MQTT_CLOUD_DEFAULT=false

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed frontends. Include BOTH localhost (dev) and your
# Netlify URL (prod) so AquaVerse works in both environments at the same time.
# The mobile app's WebView has its own origin and must be listed here, or every
# request fails CORS even though the server is reachable:
#   http://localhost / https://localhost  → Android (Capacitor)
#   capacitor://localhost                 → iOS
CORS_ORIGIN=http://localhost:5173,https://wicoaquaverse.netlify.app,http://localhost,https://localhost,capacitor://localhost

# ── Admin seed ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@irrigation.io
SEED_ADMIN_PASSWORD=Admin@1234

# ── Push notifications (optional) ────────────────────────────────────────────
# Firebase Cloud Messaging is what reaches a phone when the app is CLOSED.
# Leave both unset and the API behaves exactly as before, with push disabled.
# Provide ONE of these, from Firebase Console → Project settings → Service
# accounts → Generate new private key:
#   FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ... }   # inline JSON

# How long before the SAME device may raise the same alert again. Production
# defaults avoid spamming; drop them to 1 while demonstrating, or a second
# unplug within the window creates no alert and therefore no notification.
# ALERT_COOLDOWN_OFFLINE_MIN=60
# ALERT_COOLDOWN_BATTERY_MIN=30

# Silence before a device counts as offline. Keep ABOVE the reporting interval
# (gateway heartbeat 10s, node telemetry 5s) or healthy hardware is marked
# offline between two normal messages. A gateway losing power is usually caught
# far sooner regardless — the broker's Last Will arrives within seconds.
# OFFLINE_GATEWAY_SEC=35
# OFFLINE_NODE_SEC=30

# Minimum gap between "gateway back online" notices for the same gateway, so a
# flapping link cannot produce a storm of them.
# ONLINE_NOTICE_GAP_SEC=30

# Public sign-up is OFF by default: clients are created by an admin from the
# Clients screen. Set to true only if you want open registration.
ALLOW_PUBLIC_REGISTER=false
